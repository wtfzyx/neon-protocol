{
  "name": "neon-protocol",
  "version": "1.1.0",
  "description": "霓虹协议 · 3D 科技风机甲对战 FPS 网页游戏（Electron 桌面版）",
  "main": "main.js",
  "author": "wtfzyx",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.wtfzyx.neonprotocol",
    "productName": "NeonProtocol",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "three.min.js",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "wtfzyx",
      "repo": "neon-protocol"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
